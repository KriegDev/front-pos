    "@testing-library/react": "^16.0.1",
    "babel-loader": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jasmine-core": "^5.3.0",
    "jsdom": "^30.1.3",
    "json-server": "0.17.4",
